{
  "expo": {
    "name": "Wallet Manager",
    "slug": "my-money",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/my-money-icon.png",
    "scheme": "mymoney",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.mymoney.mobile",
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#18212C",
        "foregroundImage": "./assets/images/my-money-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10151D",
          "image": "./assets/images/my-money-foreground.png",
          "imageWidth": 148
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c172613b-a5e6-4bcd-b099-e1f5b243173f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c172613b-a5e6-4bcd-b099-e1f5b243173f"
    }
  }
}
