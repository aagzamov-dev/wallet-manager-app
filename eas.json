{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "channel": "production"
    },
    "xiaomi": {
      "extends": "production",
      "distribution": "internal",
      "env": {
        "ANDROID_BUILD_TARGET": "arm64-v8a"
      }
    }
  }
}
